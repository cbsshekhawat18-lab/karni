# The web process of {{slug}}: gunicorn with uvicorn workers, behind nginx.
# `karni make deploy systemd-nginx` wrote this file, and it is yours to edit. deploy.sh fills
# in the names between at signs from the values at its top and installs the result as
# /etc/systemd/system/<app>-web.service.
[Unit]
Description=@APP@ web (gunicorn)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
User=@RUN_AS@
Group=@RUN_AS@
WorkingDirectory=@ROOT@/current
# Worker processes, about two per CPU core. WEB_CONCURRENCY in the .env replaces it.
Environment=WEB_CONCURRENCY=2
EnvironmentFile=@ROOT@/shared/.env
# /run/@APP@/, where the socket nginx proxies to lives.
RuntimeDirectory=@APP@
ExecStart=@ROOT@/current/.venv/bin/gunicorn config.asgi:application \
    -k uvicorn_worker.UvicornWorker --bind unix:/run/@APP@/gunicorn.sock --umask 007 \
    --graceful-timeout 30 --timeout 60 --access-logfile - --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
KillMode=mixed
TimeoutStopSec=35
# Read-only everywhere but the uploads.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=@ROOT@/shared/media

[Install]
WantedBy=multi-user.target
