{
  "name": "@karni/ui",
  "version": "0.4.0",
  "description": "React components for Karni: schema-driven tables, forms, detail views and auth. Karni is an open-source Django + React framework for building with AI coding agents. Your agent writes only your domain. The API, admin, permissions and React screens come from a package you upgrade, not code it rewrites in each project. One rule set covers Claude Code, Cursor and Copilot. The build fails when an agent hand-writes what Karni ships.",
  "keywords": [
    "react",
    "django",
    "django-rest-framework",
    "openapi",
    "typescript",
    "components",
    "ui",
    "tanstack-query",
    "react-hook-form",
    "zod",
    "tailwind",
    "radix",
    "ai-agents",
    "karni"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbsshekhawat18-lab/karni.git",
    "directory": "packages/karni-ui"
  },
  "homepage": "https://github.com/cbsshekhawat18-lab/karni/tree/main/packages/karni-ui#readme",
  "bugs": {
    "url": "https://github.com/cbsshekhawat18-lab/karni/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "eslint-plugin",
    "!eslint-plugin/**/*.test.*",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind-v4.css": "./dist/tailwind-v4.css",
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js",
      "require": "./dist/tailwind-preset.cjs"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js",
      "require": "./dist/vite-plugin.cjs"
    },
    "./manifest.json": "./dist/manifest.json",
    "./eslint-plugin": "./eslint-plugin/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && eslint src --max-warnings 0 && vite build && node scripts/generate-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "peerDependencies": {
    "@hookform/resolvers": "^3.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.0.0",
    "eslint": ">=9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-visually-hidden": "^1.1.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hookform/resolvers": "^3.9.0",
    "@storybook/react": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-table": "^8.20.5",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.0",
    "msw": "^2.4.4",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.64.1",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "zod": "^3.23.8"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
