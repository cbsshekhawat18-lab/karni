# Environment for EventHub. Copy to .env:
#   cp .env.example .env
# Every value has a sane dev default baked into karni; this file makes them
# explicit. Commented-out vars are optional — leave them commented rather
# than empty (an empty value overrides the karni default with "").

# --- Core --------------------------------------------------------------------
DJANGO_ENV=dev
SECRET_KEY=karni-insecure-dev-key
DEBUG=True
ALLOWED_HOSTS=*
PROJECT_NAME=eventhub

# --- Services (docker-compose hostnames) -------------------------------------
DATABASE_URL=postgres://karni:karni@db:5432/karni
REDIS_URL=redis://redis:6379/0

# --- API ---------------------------------------------------------------------
KARNI_PAGE_SIZE=50
THROTTLE_ANON=100/min
THROTTLE_USER=1000/min
# Comma-separated origins; dev allows all origins regardless.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Proxies between clients and Django (Caddy = 1) for throttle IP resolution.
# KARNI_NUM_PROXIES=1
# Max ?expand= nesting depth on auto-generated endpoints.
# KARNI_API_MAX_EXPAND_DEPTH=2
# Swap the search backend (dotted path to a karni SearchProvider subclass).
# KARNI_SEARCH_PROVIDER=karni.api.search.postgres.PostgresSearchProvider

# --- Auth & accounts ---------------------------------------------------------
# "jwt" (SimpleJWT token pairs) or "session" (cookie auth + CSRF bootstrap).
KARNI_AUTH_MODE=jwt
# SPA origin used in account emails (verify/reset links) and, in session
# mode, added to CSRF_TRUSTED_ORIGINS.
KARNI_FRONTEND_URL=http://localhost:5173
# Social login via django-allauth (requires karni[social]; session mode only).
KARNI_SOCIAL_AUTH=False
# TOTP two-factor auth via django-otp (requires karni[2fa]).
KARNI_2FA=False
# Comma-separated allauth providers, e.g. google,github (with KARNI_SOCIAL_AUTH).
# KARNI_SOCIAL_PROVIDERS=google
# JWT lifetimes: access in minutes, refresh in days.
# KARNI_JWT_ACCESS_LIFETIME=15
# KARNI_JWT_REFRESH_LIFETIME=7
# JSON object of per-scope auth throttle overrides (null disables a scope).
# KARNI_AUTH_THROTTLE_RATES={"auth.login": "10/min"}

# --- Admin -------------------------------------------------------------------
# KARNI_ADMIN_TITLE=EventHub admin
# KARNI_ADMIN_AUTODISCOVER=True
# Comma-separated app labels or app_label.ModelName entries to skip.
# KARNI_ADMIN_EXCLUDE=sessions,contenttypes,admin

# --- Storage -----------------------------------------------------------------
# "local" (filesystem) or "s3" (any S3-compatible service; requires karni[s3]).
KARNI_STORAGE=local
MEDIA_ROOT=/data/media
STATIC_ROOT=/data/static
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=

# --- Observability -----------------------------------------------------------
# Sentry is disabled while SENTRY_DSN is empty (requires karni[sentry]).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Deployment --------------------------------------------------------------
# Domain Caddy serves (and provisions TLS for) in production.
DOMAIN=example.com

# Path *inside this project* to a local karni checkout, installed at image
# build time instead of the PyPI release (see README.md). Example:
#   cp -r /path/to/Karni/packages/karni ./.karni-src   then   KARNI_SRC=.karni-src
KARNI_SRC=
