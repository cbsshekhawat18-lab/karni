# A local @karni/ui ("file:<path>" in package.json, written by `karni new`
# from a Karni checkout) installs as a packed COPY, exactly like the npm
# release: its dependencies and peers land in this node_modules, so there is
# one React and one QueryClient, never the checkout's own node_modules.
# The copy is a snapshot: after rebuilding the checkout (npm run build there),
# refresh it with `rm -rf node_modules/@karni/ui && npm install`.
install-links=true

# npm 11 or later (package.json "engines"). npm 10, which Node 20 and 22
# bundle, cannot maintain this tree: on a fresh install it crashes while it
# resolves Vite 8's optional peers ("Cannot read properties of null (reading
# 'edgesOut')"). With engine-strict, an npm 10 that gets past that point (a
# package-lock.json exists) stops with EBADENGINE instead of only warning.
# Fix: `npx npm@11 install`, `npm install -g npm@11`, or Node 24 LTS.
engine-strict=true
