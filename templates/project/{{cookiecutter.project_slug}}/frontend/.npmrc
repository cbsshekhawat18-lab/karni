# A local @karni/ui ("file:<path>" in package.json, written by `karni new`
# from a Karni checkout) installs as a packed COPY, exactly like the npm
# release: its dependencies and peers land in this node_modules, so there is
# one React and one QueryClient, never the checkout's own node_modules.
# The copy is a snapshot: after rebuilding the checkout (npm run build there),
# refresh it with `rm -rf node_modules/@karni/ui && npm install`.
install-links=true

# engines in package.json: Node 20.19 or later (22.12 or later on Node 22, as
# Vite 8 needs) and npm 10.8 or later. With engine-strict, npm stops with
# EBADENGINE on a Node or npm outside that range instead of only warning.
engine-strict=true
