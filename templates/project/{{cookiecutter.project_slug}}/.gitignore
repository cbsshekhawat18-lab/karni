__pycache__/
*.py[cod]
# pip install -e . (the README's host workflow) leaves the project's metadata here.
*.egg-info/
.venv/
.env
# Production secrets (docker-compose.prod.yml reads them, docs/deploy.md).
.env.prod
.karni-src/
.karni-ui/
frontend/node_modules/
frontend/dist/
{%- if cookiecutter.kind == "game" %}
# The games (game/<slug>/): installs, builds, portal packages and test output.
game/*/node_modules/
game/*/dist/
game/*/dist-portals/
game/*/test-results/
game/*/playwright-report/
game/*/coverage/
{%- endif %}
/data/
# Machine-local karni state (one-time tips etc.); also self-ignored via its own .gitignore.
.karni/local/
# Development capture (DEBUG only): request records, failure snapshots, the trace.
.karni/requests/
.karni/failures/
.karni/trace/
