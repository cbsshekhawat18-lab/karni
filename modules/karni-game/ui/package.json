{
  "name": "@karni/game",
  "version": "0.5.2",
  "description": "The browser side of the Karni game add-on: portal and ad adapters, a canvas loop, input, audio, local saves, a seeded random generator, an offline-first data client and per-portal builds. Karni is an open-source Django + React framework for building with AI coding agents. Your agent writes only your domain. The API, admin, permissions and React screens come from a package you upgrade, not code it rewrites in each project. One rule set covers every coding agent. The build fails when an agent hand-writes what Karni ships.",
  "keywords": [
    "game",
    "html5",
    "canvas",
    "web-games",
    "portal",
    "ads",
    "leaderboard",
    "save",
    "phaser",
    "pixijs",
    "react-three-fiber",
    "karni"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Chandrabhan Shekhawat, Gigai Kripa Services",
    "url": "https://gigaikripaservices.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbsshekhawat18-lab/karni.git",
    "directory": "modules/karni-game/ui"
  },
  "homepage": "https://github.com/cbsshekhawat18-lab/karni/tree/main/modules/karni-game/ui#readme",
  "bugs": {
    "url": "https://github.com/cbsshekhawat18-lab/karni/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "client.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/src/tooling/index.d.ts",
      "import": "./dist/build.js"
    },
    "./vite": {
      "types": "./dist/src/tooling/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./portals/*": {
      "types": "./dist/src/portal/adapters/*.d.ts",
      "import": "./dist/portals/*.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "karni-game": "./bin/karni-game.js"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
