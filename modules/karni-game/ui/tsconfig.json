{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "noEmit": true,

    "types": ["node", "vitest/globals"],

    // The example game and the test fixtures import the package by its name, as a
    // game does: read it from src, so a fresh checkout type-checks before a build.
    "paths": {
      "@karni/game": ["./src/index.ts"],
      "@karni/game/collide": ["./src/collide/index.ts"],
      "@karni/game/draw": ["./src/draw/index.ts"],
      "@karni/game/scenes": ["./src/scenes/index.ts"],
      "@karni/game/sim": ["./src/sim/index.ts"],
      "@karni/game/ui": ["./src/ui/index.ts"],
      "@karni/game/portals/*": ["./src/portal/adapters/*.ts"]
    }
  },
  "include": [
    "src",
    "tests",
    "tests-browser",
    "example",
    "client.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.smoke.config.ts"
  ],
  "exclude": ["node_modules", "dist", "example/**/dist"]
}
