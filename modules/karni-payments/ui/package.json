{
  "name": "@karni/payments-ui",
  "version": "0.2.0",
  "description": "Payments components for Karni backends (the Django + React framework): CheckoutButton and PaymentStatus composing @karni/ui, for Stripe and Razorpay hosted checkout.",
  "keywords": [
    "react",
    "django",
    "payments",
    "stripe",
    "razorpay",
    "checkout",
    "karni"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbsshekhawat18-lab/karni.git",
    "directory": "modules/karni-payments/ui"
  },
  "homepage": "https://github.com/cbsshekhawat18-lab/karni/tree/main/modules/karni-payments/ui#readme",
  "bugs": {
    "url": "https://github.com/cbsshekhawat18-lab/karni/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx,.cjs,.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@karni/ui": "^0.2.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@karni/ui": "file:../../../packages/karni-ui",
    "@storybook/react": "^8.3.0",
    "@tanstack/react-query": "^5.56.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.0",
    "msw": "^2.4.4",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.3.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.3",
    "vite-plugin-dts": "^4.2.1",
    "vitest": "^2.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
