{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      // @karni/ui's published entry points at dist/, which is not built in a
      // fresh monorepo checkout — resolve the dependency straight to its
      // source (same strictness flags), exactly like vitest.config.ts does.
      "@karni/ui": ["../../../packages/karni-ui/src/index.ts"],
      // Pin react/react-query type identity to THIS package's node_modules so
      // the aliased @karni/ui sources and our sources share one copy of the
      // types (two @types/react copies in one program do not merge cleanly).
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"]
    },

    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": ["node_modules", "dist"]
}
